# EditorConfig helps maintain consistent coding styles across IDEs
# https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.java]
indent_style = space
indent_size = 4
continuation_indent_size = 8
insert_final_newline = true
max_line_length = 120
ij_java_align_multiline_parameters = true
ij_java_brace_style = end_of_line
ij_java_spaces_around_operators = true
ij_java_keep_blank_lines_in_code = 1
ij_java_space_after_comma = true
ij_java_wrap_long_lines = true
ij_java_use_google_style = true
ij_java_blank_lines_around_method_in_class = 1
ij_java_blank_lines_around_field = 1
ij_java_blank_lines_around_class = 1