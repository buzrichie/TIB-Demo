# =========================
# Production Environment
# =========================

SPRING_PROFILES_ACTIVE=prod

# Application
SERVER_PORT=8080

# Logging
LOGGING_LEVEL_ROOT=WARN

# CORS / API
CORS_ALLOWED_ORIGINS=https://travelitinerary.amalitech.net

# Security
JWT_SECRET=${JWT_SECRET_PROD}

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-prod.yourdomain.com

# AWS Integration
AWS_REGION=eu-west-1
AWS_LOG_GROUP=/ecs/travel-itinerary-backend
